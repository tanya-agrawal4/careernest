# ==============================================================================
# CareerNest — Backend Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ==============================================================================

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB via Prisma) ─────────────────────────────────────────────
# Full MongoDB connection string. Used by Prisma (schema.prisma → datasource.url).
DATABASE_URL= 

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL. Defaults to redis://localhost:6379 if not set.
REDIS_URL=

# ── Authentication / JWT ──────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret passphrase required during admin registration.
ADMIN_SECRET=

# ── Cloudinary (File / Image Uploads) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Gemini AI (LLM Service) ────────────────────────────────────────────
GEMINI_API_KEY=

# ── SMTP / Email (Nodemailer) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Twilio SMS (production only) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
