# ==============================================================================
# CareerNest — Frontend Environment Variables (Vite)
# ==============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ==============================================================================

# ── API Base URL ──────────────────────────────────────────────────────────────
# In development: leave empty or unset — Vite's dev proxy (/api → localhost:5000)
# handles it automatically.
# In production: set to the full backend URL, e.g. https://api.yourdomain.com/api
VITE_API_URL=
